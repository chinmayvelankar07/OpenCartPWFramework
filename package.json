{
  "name": "playwrightframeworkproject",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test:registration": "npx playwright test --grep registration",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "lint": "eslint . --ext .ts,.js --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "lint:report": "eslint . --ext .ts,.js -f html -o eslint-report/index.html || true",
    "lint:report:json": "eslint . --ext .ts,.js -f json -o eslint-report/eslint-results.json || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.3",
    "playwright-html-reporter": "^0.1.11",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
     "eslint": "^8.57.0"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "ajv": "^8.17.1",
    "jsonpath-plus": "^10.3.0"
  }
